# ─── Twilio ───────────────────────────────────────────────────────────────────
# Found in: https://console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# The public URL this server is reachable at (no trailing slash).
# Local dev: use your ngrok HTTPS URL (e.g. https://abc123.ngrok.io)
# Production: your deployed domain (e.g. https://sms.yourcompany.com)
WEBHOOK_BASE_URL=https://your-ngrok-or-domain-here.com

# ─── Slack ────────────────────────────────────────────────────────────────────
# Bot token from your Slack App → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here

# Signing secret from your Slack App → Basic Information → App Credentials
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# Default channel to post in when a number has no channel override.
# Use the channel ID (e.g. C0123456789) — more reliable than names.
SLACK_DEFAULT_CHANNEL=C0123456789

# ─── Transcription (optional) ─────────────────────────────────────────────────
# If set, voice call recordings will be transcribed (Spanish, Portuguese, English).
# Get a free key at groq.console.com
GROQ_API_KEY=

# ─── Admin API (optional) ─────────────────────────────────────────────────────
# If set, the /logs and /capabilities endpoints require this secret.
# Pass as ?secret=xxx or Authorization: Bearer xxx
# Leave blank to allow unauthenticated access (fine for local dev).
ADMIN_SECRET=

# ─── Zadarma (optional — only if you use Zadarma lines) ─────────────────────
# Setup runbook: docs/ZADARMA_SETUP.md
# API keys: my.zadarma.com → Settings → Integrations and API → API keys.
# The secret also signs Zadarma webhooks — never commit or share it.
ZADARMA_API_KEY=
ZADARMA_API_SECRET=
# Twilio SIP Domain that Zadarma numbers forward to (External Server → SIP URI)
ZADARMA_TWILIO_SIP_DOMAIN=darwin-zadarma.sip.twilio.com
# true (default) rejects /zadarma-webhook requests with an invalid Signature header.
# Set to false ONLY for the first live SMS test (failures are logged and let through).
ZADARMA_STRICT_SIGNATURE=true

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
